{
  "//": "Konfiguracja przykładowego repozytorium. Włącza też inspektory sieciowe, żeby demo pokazało pełen zakres.",
  "warnWithinDays": 30,
  "noticeWithinDays": 90,
  "obsolete": {
    "enabled": true,
    "staleAfterMonths": 12
  },
  "nuGet": {
    "enabled": true,
    "staleAfterMonths": 24
  },
  "tls": {
    "enabled": true,
    "hosts": ["nuget.org"],
    "discoverFromConfig": true
  }
}
